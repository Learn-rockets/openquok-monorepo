# Ignore files not needed for Vercel build/upload (when Root Directory is backend or web).
# See: https://vercel.com/docs/build-step#ignoring-files

.env
.env.*
!.env*.example

node_modules

# Browser extension (not built on Vercel; keep extension/package.json for the workspace)
extension/dist
extension/node_modules
extension/openquok-browser-extension.zip
extension/src
extension/scripts
extension/icons

# Local caches and prior build output (not needed for upload; can be 1GB+)
.pnpm-store
**/.svelte-kit
**/.vercel

.git

**/coverage
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js
**/*.unit.test.ts
**/*.integration.test.ts
**/*.e2e.test.ts
**/tests/
**/__tests__/

.DS_Store
Thumbs.db
.idea
.vscode
.cursor

*.log

backend/supabase/

# Local prod dumps (PII) — never upload
.backups
.backups/**
